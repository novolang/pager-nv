// hostile_tests.nv — a log in which every frame is a commit record.

use std.test
use std.list
use std.fs
use std.str
use pagefmt
use pager
use pagefmt.{ Checksum, WalFrame, WalHeader }

fn scratch() -> Str
    "/tmp/pager-nv-hostile.db"

fn erase() [fs]
    let _ = fs.delete(scratch())
    let _ = fs.delete(scratch() + "-wal")

fn word_at(raw: [Int], at: Int) -> Int
    (list.get(raw, at, 0) << 24) | (list.get(raw, at + 1, 0) << 16)
        | (list.get(raw, at + 2, 0) << 8) | list.get(raw, at + 3, 0)

// A log of `frames` frames of page 2, each of which declares the
// database two pages long, so that each is a commit record.
fn write_log(db: Str, frames: Int) -> Bool [fs]
    let head = WalHeader { version: 1, page_size: 512, checkpoint_seq: 0,
                                   salt1: 1, salt2: 2, checksum1: 0, checksum2: 0 }
    let header_bytes = pagefmt.encode_wal_header(head)
    let sealed = match pagefmt.decode_wal_header(header_bytes)
        Ok(h)  => h
        Err(_) => head
    let fd = match fs.open_write(db + "-wal")
        Some(h) => h
        None    =>
            return false
    var ok = fs.write_at(fd, 0, header_bytes) == None
    var running = pagefmt.checksum_seed(sealed)
    let page = list.zeros(512)
    var batch: [Int] = []
    var batch_at = pagefmt.frame_offset(512, 0)
    var n = 0
    while n < frames
        let frame = WalFrame { page_id: 2, db_size_after: 2, salt1: 1, salt2: 2,
                               checksum1: 0, checksum2: 0 }
        let raw = pagefmt.encode_wal_frame(frame, page, running)
        running = Checksum { s1: word_at(raw, 16), s2: word_at(raw, 20) }
        batch = list.append(batch, raw)
        n = n + 1
        if list.len(batch) >= 512 * 1024 or n == frames
            ok = ok and fs.write_at(fd, batch_at, batch) == None
            batch_at = pagefmt.frame_offset(512, n)
            batch = []
    fs.close(fd)
    ok

// How many read calls this process has made so far, from the kernel's
// own account of it, or -1 on a machine that keeps none.  The read of
// the account is itself a few calls, the same few every time.
fn reads_so_far() -> Int [fs]
    let text = fs.read("/proc/self/io") ?? ""
    for line in str.split(text, "\n")
        if str.starts_with(line, "syscr: ")
            return str.to_int(str.trim(str.slice(line, 7, str.len(line)))) ?? 0 - 1
    0 - 1

// The read calls it takes to open a database whose log holds this many
// frames, every one of them a commit record, or -1 when a step is
// refused or the machine keeps no account.
fn reads_to_recover(frames: Int) -> Int [fs]
    erase()
    let p = match pager.create(scratch(), 512)
        Err(_) =>
            return 0 - 1
        Ok(q)  => q
    let _ = pager.close(p)
    if not write_log(scratch(), frames)
        return 0 - 1
    let before = reads_so_far()
    let opened = pager.open(scratch())
    let after = reads_so_far()
    match opened
        Err(_) =>
            0 - 1
        Ok(q)  =>
            let counted = pager.stats(q).wal_frames
            let _ = pager.close(q)
            if counted != frames or before < 0 or after < 0
                0 - 1
            else
                after - before

@test
fn test_a_log_of_many_commit_records_is_recovered_in_linear_work() [io, fs]
    // The work is counted and not timed: recovery reads each frame
    // once, so opening a log of twice the frames takes twice the read
    // calls (and a few more for the two headers).  A scan that went
    // back over the log at every commit record would take four times.
    // A copy of the frame list at every record makes no read call and is
    // not counted here: `recover_log` takes its one copy at the end.
    if fs.exists("/proc/self/io")
        let small = reads_to_recover(2000)
        let large = reads_to_recover(4000)
        test.assert(small >= 2000)
        test.assert(small < 2000 + 16)
        test.assert(large >= 4000)
        test.assert(large <= 2 * small + 16)
    else
        test.assert_true(true, "this machine keeps no account of its read calls")
    erase()

@test
fn test_a_log_with_two_commit_records_is_recovered() [io, fs]
    erase()
    match pager.create(scratch(), 512)
        Err(_) => test.fail("create")
        Ok(p)  =>
            let _ = pager.close(p)
            test.assert(write_log(scratch(), 2))
            match pager.open(scratch())
                Err(_) => test.fail("the log is well formed")
                Ok(q)  =>
                    test.assert(pager.stats(q).wal_frames == 2)
                    let _ = pager.close(q)
    erase()
