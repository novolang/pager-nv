// pagefmt.nv — the bytes at the front of the file, and at the front
// of every log frame.
//
// Pure arithmetic over byte lists, with no `[fs]` anywhere in it.  The
// module is in a `host` package because the FORMAT is the pager's —
// nothing else in the grid has an opinion about what a database file's
// header holds — but every function here could be `core` and is
// written so that moving it later costs a manifest edit and nothing
// else.  That also makes the format testable without a filesystem,
// which is what `tests/pagefmt_tests.nv` does.
//
// THE DATABASE HEADER — page 1's first 48 bytes
//
//   bytes 0..3     magic, "NVPG"
//   bytes 4..7     format version, big-endian u32
//   bytes 8..11    page size in bytes, big-endian u32
//   bytes 12..15   page count, big-endian u32
//   bytes 16..19   first page of the free list, 0 for none
//   bytes 20..23   free-list page count
//   bytes 24..27   change counter, incremented at every commit
//   bytes 28..31   schema cookie, incremented at every DDL statement
//   bytes 32..35   the catalog's root page
//   bytes 36..47   reserved, zero
//
// THE WAL HEADER — 32 bytes at the front of the log file
//
//   bytes 0..3     magic, "NVWL"
//   bytes 4..7     format version, big-endian u32
//   bytes 8..11    page size, which must equal the database's
//   bytes 12..15   checkpoint sequence, incremented at every checkpoint
//   bytes 16..19   salt 1, changed at every checkpoint
//   bytes 20..23   salt 2, random at every checkpoint
//   bytes 24..27   checksum 1 over bytes 0..23
//   bytes 28..31   checksum 2 over bytes 0..23
//
// A WAL FRAME HEADER — 24 bytes, then one page of content
//
//   bytes 0..3     the page id this frame holds
//   bytes 4..7     the database size in pages after this frame, or 0
//                  when the frame is not a commit
//   bytes 8..11    salt 1, copied from the WAL header
//   bytes 12..15   salt 2, copied from the WAL header
//   bytes 16..19   checksum 1, over the running total and this frame
//   bytes 20..23   checksum 2
//
// THE SALTS ARE THE POINT OF THE WAL DESIGN, so they are worth
// stating rather than leaving to be inferred: a frame whose salts do
// not match the header's is a frame from BEFORE the last checkpoint,
// left in the file because the log is written in place and never
// truncated.  That is what makes a checkpoint O(1) at the end and what
// makes recovery a forward scan that stops by itself.
//
// WHAT THIS IS NOT DERIVED FROM
//
// novodb has no write-ahead log.  Its `pagefile.nv` writes a whole
// image and its v2 format appends a NEW image and moves an offset in
// an outer header, with recovery by scanning the file for valid image
// offsets and taking the last one before a limit.  That is a
// log-structured file, not a WAL: it is crash-safe, and it rewrites
// everything on every commit.  The frame format above is designed here
// against SQLite's, which is the reference the must-have plan names.

use std.list

// ── bytes out, bytes in ──────────────────────────────────────────────

// Big-endian because the layout says so: one byte order for the whole
// format, so a file written on one machine reads on the next.
fn be_u32(v: Int) -> [Int]
    [(v >>> 24) & 255, (v >>> 16) & 255, (v >>> 8) & 255, v & 255]

// Four bytes as a 32-bit word.  `list.get`'s three-argument form pads
// with zeros, so a word that runs past the end reads as a short word
// instead of failing — which is the tail the rolling checksum needs.
fn u32_at(bytes: [Int], at: Int) -> Int
    let b0 = list.get(bytes, at, 0)
    let b1 = list.get(bytes, at + 1, 0)
    let b2 = list.get(bytes, at + 2, 0)
    let b3 = list.get(bytes, at + 3, 0)
    (b0 << 24) | (b1 << 16) | ((b2 << 8) | b3)

// A power of two from 512 to 65536, which is SQLite's range and what
// every offset in this package is computed on.
fn page_size_ok(size: Int) -> Bool
    size >= 512 and size <= 65536 and (size & (size - 1)) == 0

// The four bytes a file of this format starts with, named so that the
// check in the decoders reads as a magic and not as four numbers.
fn db_magic() -> [Int]
    [78, 86, 80, 71]

fn wal_magic() -> [Int]
    [78, 86, 87, 76]

// The one format version this build reads.  A second one bumps this,
// and the reader that cannot read it says so instead of guessing.
fn format_version() -> Int
    1

// The 48-byte database header, decoded.
pub struct DbHeader
    version: Int
    page_size: Int
    page_count: Int
    freelist_head: Int
    freelist_count: Int
    // Incremented at every commit.  A reader that cached pages checks
    // this before trusting them, which is the cheapest staleness
    // detector there is.
    change_counter: Int
    // Incremented at every DDL statement.  A prepared statement holds
    // the value it was planned against and is re-prepared when it
    // moves, because a plan outliving its schema is how a query
    // silently reads the wrong column.
    schema_cookie: Int
    catalog_root: Int

// The 32-byte WAL header, decoded.
pub struct WalHeader
    version: Int
    page_size: Int
    checkpoint_seq: Int
    salt1: Int
    salt2: Int
    checksum1: Int
    checksum2: Int

// A 24-byte WAL frame header, decoded.
pub struct WalFrame
    page_id: Int
    // The database size in pages after this frame, or 0 when the frame
    // is not the last of a transaction.  A non-zero value IS the
    // commit record: there is no separate one.
    db_size_after: Int
    salt1: Int
    salt2: Int
    checksum1: Int
    checksum2: Int

// The size of the database header in bytes.
pub fn db_header_size() -> Int
    48

// The size of the WAL header in bytes.
pub fn wal_header_size() -> Int
    32

// The size of a WAL frame header in bytes.
pub fn wal_frame_header_size() -> Int
    24

// The default page size for a file this pager creates.
//
// 4096, which is btree-nv's `nodefmt.page_size()` and every
// filesystem's block size.  A file may declare another in its header
// and this pager will read it; it writes this one.
pub fn default_page_size() -> Int
    4096

// A fresh database header for an empty file.
pub fn new_db_header(page_size: Int) -> DbHeader
    // Page 1 holds this header, so an empty file is one page.  The
    // change counter is zero: it counts commits, and there have been
    // none.  Nothing here checks the page size — a header is built and
    // then encoded, and the encoder writes what it was given.
    DbHeader { version: format_version(), page_size: page_size, page_count: 1,
               freelist_head: 0, freelist_count: 0, change_counter: 0,
               schema_cookie: 0, catalog_root: 0 }

// Write the database header out.
//
// Returns exactly `db_header_size()` bytes.
pub fn encode_db_header(h: DbHeader) -> [Int]
    var out = db_magic()
    out = list.append(out, be_u32(h.version))
    out = list.append(out, be_u32(h.page_size))
    out = list.append(out, be_u32(h.page_count))
    out = list.append(out, be_u32(h.freelist_head))
    out = list.append(out, be_u32(h.freelist_count))
    out = list.append(out, be_u32(h.change_counter))
    out = list.append(out, be_u32(h.schema_cookie))
    out = list.append(out, be_u32(h.catalog_root))
    // The twelve reserved bytes, zero, which is what puts the header
    // at its documented 48.
    out = list.append(out, list.zeros(12))
    out

// Read the database header, or say why the bytes are not one.
pub fn decode_db_header(bytes: [Int]) -> Result<DbHeader, FormatError>
    let have = list.len(bytes)
    let magic_len = list.len(db_magic())
    if have < magic_len
        return Err(TooShort(want: db_header_size(), have: have))
    let magic = list.take(bytes, magic_len)
    if magic != db_magic()
        return Err(BadMagic(got: magic))
    if have < db_header_size()
        return Err(TooShort(want: db_header_size(), have: have))
    let version = u32_at(bytes, 4)
    if version != format_version()
        return Err(BadVersion(got: version, supported: format_version()))
    let size = u32_at(bytes, 8)
    if not page_size_ok(size)
        return Err(BadPageSize(got: size))
    Ok(DbHeader { version: version, page_size: size, page_count: u32_at(bytes, 12),
                  freelist_head: u32_at(bytes, 16), freelist_count: u32_at(bytes, 20),
                  change_counter: u32_at(bytes, 24), schema_cookie: u32_at(bytes, 28),
                  catalog_root: u32_at(bytes, 32) })

// Write the WAL header out.
//
// The two checksums are computed over the first 24 bytes and written
// into the last 8, so the returned header is self-consistent and
// `decode_wal_header` will accept it.
pub fn encode_wal_header(h: WalHeader) -> [Int]
    var out = wal_magic()
    out = list.append(out, be_u32(h.version))
    out = list.append(out, be_u32(h.page_size))
    out = list.append(out, be_u32(h.checkpoint_seq))
    out = list.append(out, be_u32(h.salt1))
    out = list.append(out, be_u32(h.salt2))
    // The twenty-four bytes above ARE the checksum's input, which is
    // why they are assembled before the two words are.
    let c = checksum(Checksum { s1: 0, s2: 0 }, out)
    out = list.append(out, be_u32(c.s1))
    out = list.append(out, be_u32(c.s2))
    out

// Read the WAL header, checking both checksums.
pub fn decode_wal_header(bytes: [Int]) -> Result<WalHeader, FormatError>
    let have = list.len(bytes)
    let magic_len = list.len(wal_magic())
    if have < magic_len
        return Err(TooShort(want: wal_header_size(), have: have))
    let magic = list.take(bytes, magic_len)
    if magic != wal_magic()
        return Err(BadMagic(got: magic))
    if have < wal_header_size()
        return Err(TooShort(want: wal_header_size(), have: have))
    let stored1 = u32_at(bytes, 24)
    let stored2 = u32_at(bytes, 28)
    let c = checksum(Checksum { s1: 0, s2: 0 }, list.take(bytes, 24))
    if c.s1 != stored1 or c.s2 != stored2
        return Err(BadChecksum(page_id: 0))
    let version = u32_at(bytes, 4)
    if version != format_version()
        return Err(BadVersion(got: version, supported: format_version()))
    let size = u32_at(bytes, 8)
    if not page_size_ok(size)
        return Err(BadPageSize(got: size))
    Ok(WalHeader { version: version, page_size: size, checkpoint_seq: u32_at(bytes, 12),
                   salt1: u32_at(bytes, 16), salt2: u32_at(bytes, 20),
                   checksum1: stored1, checksum2: stored2 })

// Write a frame header out, given the running checksum before it.
//
// The checksum is CUMULATIVE — see `checksum` — so a frame cannot be
// written without knowing what came before it, and that is what makes
// a frame inserted into the middle of a log detectable.
pub fn encode_wal_frame(f: WalFrame, page: [Int], running: Checksum) -> [Int]
    var out = be_u32(f.page_id)
    out = list.append(out, be_u32(f.db_size_after))
    out = list.append(out, be_u32(f.salt1))
    out = list.append(out, be_u32(f.salt2))
    // The first eight bytes are the frame's own claim about WHERE it
    // goes; the twelve after them are salts and a checksum, and a
    // checksum cannot cover itself.
    let c = checksum(checksum(running, list.take(out, 8)), page)
    out = list.append(out, be_u32(c.s1))
    out = list.append(out, be_u32(c.s2))
    out = list.append(out, page)
    out

// Read a frame header, checking it against the running checksum.
pub fn decode_wal_frame(bytes: [Int], page: [Int],
                        running: Checksum) -> Result<WalFrame, FormatError>
    let have = list.len(bytes)
    if have < wal_frame_header_size()
        return Err(TooShort(want: wal_frame_header_size(), have: have))
    let page_id = u32_at(bytes, 0)
    let db_size_after = u32_at(bytes, 4)
    let salt1 = u32_at(bytes, 8)
    let salt2 = u32_at(bytes, 12)
    let stored1 = u32_at(bytes, 16)
    let stored2 = u32_at(bytes, 20)
    let c = checksum(checksum(running, list.take(bytes, 8)), page)
    if c.s1 != stored1 or c.s2 != stored2
        return Err(BadChecksum(page_id: page_id))
    Ok(WalFrame { page_id: page_id, db_size_after: db_size_after, salt1: salt1,
                  salt2: salt2, checksum1: stored1, checksum2: stored2 })

// A running checksum: two 32-bit halves.
pub struct Checksum
    s1: Int
    s2: Int

// The checksum the WAL starts from, seeded by the header's salts.
pub fn checksum_seed(h: WalHeader) -> Checksum
    // The header's own two words ARE the seed: they are the checksum
    // of its first twenty-four bytes, and a frame's checksum runs on
    // from there.
    Checksum { s1: h.checksum1, s2: h.checksum2 }

// Fold a run of bytes into the running checksum.
//
// SQLite's rolling pair — `s1 += x + s2; s2 += x + s1` over 32-bit
// big-endian words, both halves truncated to 32 bits — chosen because
// it is the reference implementation's and because it is cumulative:
// a checksum over one frame alone would not notice a frame lifted out
// of another log and dropped in, and this one does.
pub fn checksum(running: Checksum, bytes: [Int]) -> Checksum
    // A byte run that is not a multiple of eight is padded with zeros,
    // which is what SQLite does and what `u32_at` does for the tail
    // without a copy.
    let n = list.len(bytes)
    var s1 = running.s1
    var s2 = running.s2
    var i = 0
    while i < n
        let x0 = u32_at(bytes, i)
        let x1 = u32_at(bytes, i + 4)
        s1 = (s1 + x0 + s2) & 4294967295
        s2 = (s2 + x1 + s1) & 4294967295
        i = i + 8
    Checksum { s1: s1, s2: s2 }

// True when a frame's salts match this WAL header's.
//
// A frame that does not is a frame from before the last checkpoint,
// left in the file because the log is written in place and never
// truncated.  Recovery stops at the first one.
pub fn frame_is_current(f: WalFrame, h: WalHeader) -> Bool
    f.salt1 == h.salt1 and f.salt2 == h.salt2

// The byte offset of frame `n`, zero-based, in a WAL of this page
// size.
pub fn frame_offset(page_size: Int, n: Int) -> Int
    wal_header_size() + n * (wal_frame_header_size() + page_size)

// Why a run of bytes is not the header or frame it claimed to be.
pub enum FormatError
    // The magic is not this format's.  `got` is the four bytes read.
    BadMagic(got: [Int])
    // The version is one this build does not read.
    BadVersion(got: Int, supported: Int)
    // The buffer is shorter than the structure it was asked for.
    TooShort(want: Int, have: Int)
    // A checksum did not match.  The page id is the frame's, or 0 for
    // a header.
    BadChecksum(page_id: Int)
    // The page size is not a power of two in 512..=65536.
    BadPageSize(got: Int)
    // The WAL's page size and the database's disagree, which means the
    // two files are not a pair.
    PageSizeMismatch(db: Int, wal: Int)

// The human sentence behind each way a header or frame can be wrong.
impl Error for FormatError
    fn message(self) -> Str
        match self
            BadMagic(_)            =>
                "not a pager-nv file: the first four bytes are not its magic"
            BadVersion(_, _)       =>
                "the file's format version is one this build does not read"
            TooShort(_, _)         =>
                "the buffer is shorter than the structure it was asked for"
            BadChecksum(_)         =>
                "a checksum did not match, so these are not the bytes that were written"
            BadPageSize(_)         =>
                "the page size is not a power of two between 512 and 65536"
            PageSizeMismatch(_, _) =>
                "the log's page size and the database's disagree, so the two files are not a pair"
